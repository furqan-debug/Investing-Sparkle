# Copy to .env.local and fill in. Never commit .env.local.

# --- Analytics (all optional; unset = that script never loads) ---
# Plausible: your verified domain, e.g. investingsparkle.com
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX
NEXT_PUBLIC_GA_ID=
# Meta (Facebook) Pixel ID, for retargeting
NEXT_PUBLIC_FB_PIXEL_ID=

# --- Newsletter (see app/api/subscribe/route.ts) ---
CONVERTKIT_API_KEY=
CONVERTKIT_FORM_ID=

# --- Google sign-in for the free tools (see lib/auth.ts and README) ---
# OAuth 2.0 Client ID (Web application) from Google Cloud Console. The tools
# stay locked until this and AUTH_SECRET are set. The session route passes the
# ID to the page, so NEXT_PUBLIC_ is not required.
GOOGLE_CLIENT_ID=
# Optional alias, if you prefer exposing the ID at build time.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# Signs the session cookie. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=

# --- Transactional email (see app/api/contact/route.ts and app/api/tool-result/route.ts) ---
RESEND_API_KEY=

# --- Optional scheduling (content/integrations.ts) ---
# Set to your Calendly link to offer self-scheduling alongside WhatsApp.
NEXT_PUBLIC_CALENDLY_URL=

# --- Online payments (Phase 2 — see content/integrations.ts before enabling) ---
# Leave false until merchant accounts and the checkout/webhook routes exist.
NEXT_PUBLIC_PAYMENTS_ENABLED=false
